{
  "name": "cividlization2",
  "version": "1.3.7",
  "private": true,
  "description": "Run the original Kongregate static build and the reconstructed Angular source",
  "scripts": {
    "start": "npm run start:old",
    "start:old": "node scripts/serve-old.mjs",
    "start:decompiled": "npm --prefix decompiled/angular-src start",
    "start:all": "npm-run-all --parallel start:old start:decompiled",
    "build:kernel": "node scripts/build-game-kernel.mjs",
    "build:decompiled": "npm run build:kernel && npm --prefix decompiled/angular-src run build",
    "install:all": "npm install && npm --prefix decompiled/angular-src install"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "sirv": "^3.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
